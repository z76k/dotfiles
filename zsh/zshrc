# ============ 1. Terminal ============
# If the terminal's TERM has no terminfo entry (e.g. xterm-ghostty), fall back.
if ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM=xterm-256color
fi
if [[ -o interactive && $TERM_PROGRAM == ghostty ]] && (( $+commands[fastfetch] )); then
  fastfetch   # startup banner, Ghostty only
fi

# ============ 2. PATH (later lines win) ============
typeset -U path   # drop duplicate entries
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.cargo/bin:$PATH"
export PATH="$PATH:$HOME/.lmstudio/bin"   # LM Studio CLI

# ============ 3. Environment ============
export EDITOR="vim" VISUAL="vim"
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications/apps"
export HOMEBREW_NO_ASK=1
export GLAZE_SDK_PATH="$HOME/Library/Application Support/app.glaze.macos.main/sdk/current"

# ============ 4. History ============
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS EXTENDED_HISTORY

# ============ 5. Completion and vi mode ============
fpath+=("/opt/homebrew/share/zsh/site-functions")   # must be set BEFORE compinit
autoload -Uz compinit
# Full rebuild at most once a day; otherwise use the cache (faster startup)
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
set -o vi
KEYTIMEOUT=1   # no delay when pressing Esc

# ============ 6. Tools ============
# Order matters: Atuin must come after fzf so Atuin owns Ctrl-R.
if command -v fzf >/dev/null; then
  eval "$(fzf --zsh)"   # Ctrl-T files, Alt-C directories
  if command -v fd >/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi
  export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :200 {}'"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"
fi
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"   # defines z and zi
command -v atuin  >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# ============ 7. Aliases ============
if command -v eza >/dev/null; then
  alias ls='eza -1 --group-directories-first'
  alias ll='eza -lah --git --group-directories-first'
  alias lt='eza --tree --level=2'
fi
command -v bat >/dev/null && alias cat='bat --paging=never'
alias markedit='open -a Markedit.app'
alias yz='yazi'
alias ge='ghostty +edit-config'
alias vz='vim ~/.config/zsh/zshrc'
alias fdt='fd -e dmg . ~/Downloads -X trash'   # trash all DMGs in Downloads
alias csync='git -C ~/.config add -A && git -C ~/.config commit -m "Update config" && git -C ~/.config push'

# ============ 8. Functions ============
mkcd() { mkdir -p "$1" && cd "$1"; }

# Files into $EDITOR / default app / Finder (Rex calls these)
fe() {
  local file
  file=$(fzf --query="$1" --preview 'bat --color=always --line-range :200 {} 2>/dev/null || cat {}') \
    && ${EDITOR:-vim} "$file"
}
fo() {
  local file
  file=$(fd . ~ --type f --exclude Library --exclude node_modules | fzf) && open "$file"
}
ff() {
  local file
  file=$(fd . ~ --exclude Library --exclude node_modules | fzf) && open -R "$file"
}
fcd() { cd "$(fd --type d --hidden --exclude .git . ~ | fzf)"; }

# Homebrew uninstallers
buf()  { local p; p=$(brew leaves | fzf) && brew uninstall "$p"; }
buzf() { local p; p=$(brew list --cask | fzf) && brew uninstall --zap "$p"; }

# Pick a running app and quit it
fquit() {
  local app
  app=$(osascript -e 'tell app "System Events" to get name of every process whose background only is false' |
    tr ',' '\n' | sed 's/^ //' | fzf) && osascript -e "quit app \"$app\""
}


# ============ 9. Prompt (Pure; brew install pure) ============
zmodload zsh/nearcolor   # hex colors on 256-color terminals
zstyle ':prompt:pure:path' color '#00a896'
zstyle ':prompt:pure:prompt:success' color '#ff7b00'
zstyle ':prompt:pure:prompt:error' color red
zstyle ':prompt:pure:git:branch' color '#00a896'
zstyle ':prompt:pure:git:dirty' color '#ff7b00'
zstyle ':prompt:pure:git:arrow' color '#ff7b00'
zstyle ':prompt:pure:execution_time' color '#ff7b00'
zstyle ':prompt:pure:environment:virtualenv' show no
zstyle ':prompt:pure:environment:nix-shell' show no
autoload -U promptinit; promptinit
if (( ${prompt_themes[(I)pure]} )); then
  prompt pure
else
  print -P "%F{yellow}pure prompt not installed — run: brew install pure%f"
fi

# ============ 10. Plugins (syntax-highlighting must stay LAST) ============
# Autosuggestions: Tab accepts the grey suggestion, otherwise normal completion.
if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_AUTOSUGGEST_PARTIAL_ACCEPT_WIDGETS+=(forward-word)
  _tab_accept_or_complete() {
    if [[ -n $POSTDISPLAY ]]; then zle autosuggest-accept; else zle expand-or-complete; fi
  }
  zle -N _tab_accept_or_complete
  bindkey '^I' _tab_accept_or_complete   # Tab
  bindkey '^[[Z' forward-word            # Shift+Tab: accept one word
fi
if [[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
